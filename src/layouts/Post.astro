---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import { formatDate, getPosts, readingTime } from '../posts';
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const posts = await getPosts();
const index = posts.findIndex(entry => entry.id === post.id);
const next = posts[(index + 1) % posts.length];
---
<Base title={post.data.title} description={post.data.description} active="Writing" article published={post.data.date}>
  <article class="article">
    <a class="text-link article-back" href="/blog/"><Icon name="back" size={16} />All writing</a>
    <header class="article-header"><div class="article-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span aria-hidden="true">·</span><span>{readingTime(post)} min read</span></div><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div></header>
    {headings.length > 3 && <details class="table-of-contents"><summary>In this article<span aria-hidden="true">+</span></summary><ol>{headings.map(heading => <li class:list={{ nested: heading.depth > 2 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details>}
    <div class="prose"><Content /></div>
    <div class="article-end"><span>Thanks for reading.</span><a class="text-link" href={`mailto:liuyang1520@gmail.com?subject=${encodeURIComponent(post.data.title)}`}>Continue the conversation<Icon name="external" size={15} /></a></div>
  </article>
  {next && next.id !== post.id && <aside class="next-post"><span class="eyebrow">KEEP READING</span><a href={next.data.permalink}>{next.data.title}<Icon name="arrow" size={20} /></a></aside>}
</Base>
